-- movement ------------------------------------------------------------
local origWS, origJP
local Fly = {on=false, vel=Vector3.zero, tilt=0, roll=0, flat=Vector3.new(0,0,-1)}
local function flyStop()
    if not Fly.on then return end
    Fly.on = false
    local h, r = hum(), hrp()
    for _,o in ipairs({Fly.att, Fly.lv, Fly.ao, Fly.trail, Fly.ta0, Fly.ta1, Fly.wind}) do
        if o then pcall(function() o:Destroy() end) end
    end
    Fly.att, Fly.lv, Fly.ao, Fly.trail, Fly.ta0, Fly.ta1, Fly.wind = nil, nil, nil, nil, nil, nil, nil
    if h then h.PlatformStand = false h.AutoRotate = true end
    if r then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
        local f = Fly.flat
        r.CFrame = CFrame.lookAt(r.Position, r.Position + Vector3.new(f.X,0,f.Z))
    end
    local c = cam()
    if c and Fly.baseFov then c.FieldOfView = Fly.baseFov end
    Fly.baseFov, Fly.vel, Fly.tilt, Fly.roll = nil, Vector3.zero, 0, 0
end
local function flyStart()
    local h, r = hum(), hrp()
    if not h or not r or h.Health <= 0 then return end
    Fly.on = true
    Fly.vel, Fly.tilt, Fly.roll = Vector3.zero, 0, 0
    Fly.att = new("Attachment",{Name="SlinFlyAtt",Parent=r})
    Fly.lv = new("LinearVelocity",{Attachment0=Fly.att,MaxForce=math.huge,VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
        RelativeTo=Enum.ActuatorRelativeTo.World,VectorVector=Vector3.zero,Parent=r})
    Fly.ao = new("AlignOrientation",{Attachment0=Fly.att,Mode=Enum.OrientationAlignmentMode.OneAttachment,MaxTorque=math.huge,
        Responsiveness=22,CFrame=r.CFrame.Rotation,Parent=r})
    Fly.ta0 = new("Attachment",{Name="SlinFlyT0",Position=Vector3.new(0,1.1,0.5),Parent=r})
    Fly.ta1 = new("Attachment",{Name="SlinFlyT1",Position=Vector3.new(0,-1.1,0.5),Parent=r})
    Fly.trail = new("Trail",{Attachment0=Fly.ta0,Attachment1=Fly.ta1,Lifetime=0.6,LightEmission=1,FaceCamera=true,Enabled=false,
        Transparency=NS{{0,0.15},{1,1}},WidthScale=NS{{0,1},{1,0}},Parent=r})
    Fly.wind = new("ParticleEmitter",{Rate=0,Lifetime=NumberRange.new(0.4,0.8),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(180,180),
        LightEmission=1,Size=NS{{0,0.3},{1,0}},Transparency=NS{{0,0.3},{1,1}},Parent=r})
    h.PlatformStand = true
    h.AutoRotate = false
    local c = cam()
    Fly.baseFov = c and c.FieldOfView or 70
end
local function flyStep(h, r, dt)
    local c = cam()
    local look = c.CFrame.LookVector
    local flat = Vector3.new(look.X,0,look.Z)
    if flat.Magnitude > 0.05 then Fly.flat = flat.Unit end
    flat = Fly.flat
    local right = flat:Cross(Vector3.yAxis)
    local mv = h.MoveDirection
    local fwdC = mv:Dot(flat)
    local busy = typing()
    local up = (not busy and UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (not busy and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.C)) and 1 or 0)
    local boost = (not busy and UIS:IsKeyDown(Enum.KeyCode.LeftShift)) and 1.8 or 1
    local target = Vector3.new(mv.X, look.Y*fwdC + up*0.85, mv.Z)
    if target.Magnitude > 1 then target = target.Unit end
    local top = S.flySpeed * boost
    target = target * top
    Fly.vel = Fly.vel:Lerp(target, 1 - math.exp(-dt*S.flyAccel))
    local bob = (target.Magnitude < 1) and math.sin(os.clock()*2.2)*1.4 or 0
    Fly.lv.VectorVelocity = Fly.vel + Vector3.new(0,bob,0)
    local fwdN = math.clamp(Fly.vel:Dot(flat)/top,-1,1)
    local sideN = math.clamp(Fly.vel:Dot(right)/top,-1,1)
    local k = 1 - math.exp(-dt*8)
    Fly.tilt += ((S.flyLean and fwdN*math.rad(70) or 0) - Fly.tilt)*k
    Fly.roll += ((S.flyLean and sideN*math.rad(40) or 0) - Fly.roll)*k
    Fly.ao.CFrame = CFrame.lookAt(Vector3.zero, flat) * CFrame.Angles(-Fly.tilt,0,-Fly.roll)
    local speed = Fly.vel.Magnitude
    local col = CS{{0,S.c1},{1,S.c2}}
    Fly.trail.Color = col
    Fly.trail.Enabled = S.flyTrail and speed > 8
    Fly.wind.Color = col
    Fly.wind.Rate = S.flyWind and math.clamp(speed*1.2,0,120) or 0
    local goal = Fly.baseFov + (S.flyFov and 18*math.clamp(speed/(S.flySpeed*1.8),0,1) or 0)
    c.FieldOfView += (goal - c.FieldOfView)*k
end
bind(LP.CharacterAdded,function()
    Fly.on, Fly.baseFov, Fly.vel, Fly.tilt, Fly.roll = false, nil, Vector3.zero, 0, 0
    origWS, origJP = nil, nil
end)
bind(UIS.JumpRequest,function()
    if S.infJump then local h=hum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
end)

local hops, lastHop = 0, 0
bind(RunService.Heartbeat,function(dt)
    local h, r = hum(), hrp()
    if not h or not r then return end
    if S.speedOn then origWS = origWS or h.WalkSpeed h.WalkSpeed = S.speed
    elseif origWS then h.WalkSpeed = origWS origWS = nil end
    if S.jumpOn then
        origJP = origJP or h.JumpPower
        h.UseJumpPower = true h.JumpPower = S.jump
    elseif origJP then h.JumpPower = origJP origJP = nil end
    if S.flyOn and not Fly.on then flyStart()
    elseif not S.flyOn and Fly.on then flyStop() end
    if Fly.on then
        if not Fly.lv or not Fly.lv.Parent then flyStop()
        else
            h.PlatformStand = true
            h.AutoRotate = false
            flyStep(h, r, dt)
        end
    end
    if not isAdmin() then return end
    if S.spinOn then r.CFrame = r.CFrame*CFrame.Angles(0,math.rad(S.spinSpeed)*dt,0) end
    if S.bhop and not Fly.on then
        local space = UIS:IsKeyDown(Enum.KeyCode.Space) and not typing()
        local grounded = h.FloorMaterial~=Enum.Material.Air
        local vel = r.AssemblyLinearVelocity
        local hv = Vector3.new(vel.X,0,vel.Z)
        local wish = h.MoveDirection
        if not space and os.clock()-lastHop>0.35 then hops = 0 end
        if space and grounded then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
            hops += 1 lastHop = os.clock()
            if wish.Magnitude>0.1 then
                local sp = math.min(math.max(hv.Magnitude,h.WalkSpeed)*1.03,S.bhopMax)
                r.AssemblyLinearVelocity = Vector3.new(wish.X*sp,vel.Y,wish.Z*sp)
            end
        elseif space and not grounded and wish.Magnitude>0.1 then
            local ws = math.min(S.bhopMax*0.5,40)
            local add = ws-hv:Dot(wish)
            if add>0 then
                local nv = hv+wish*math.min(14*dt*ws,add)
                if nv.Magnitude>S.bhopMax then nv = nv.Unit*S.bhopMax end
                r.AssemblyLinearVelocity = Vector3.new(nv.X,vel.Y,nv.Z)
            end
        end
    end
end)
bind(RunService.Stepped,function()
    if S.noclip and isAdmin() then
        local ch = LP.Character
        if ch then for _,p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end
    end
end)
cleanups[#cleanups+1] = function()
    flyStop()
    local h = hum()
    if h then if origWS then h.WalkSpeed=origWS end if origJP then h.JumpPower=origJP end end
    for p in pairs(esp) do espRemove(p) end
end

