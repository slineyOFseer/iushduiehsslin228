local DASH = NS{{0,0},{0.24,0},{0.25,1},{0.49,1},{0.5,0},{0.74,0},{0.75,1},{1,1}}
local function makeReticle(kind, parent)
    local R = {frames={}}
    R.root = new("CanvasGroup",{AnchorPoint=CEN,BackgroundTransparency=1,Size=UDim2.fromOffset(60,60),Visible=false,Parent=parent})
    local function line(par,ax,ay,px,py,sx,sy,rot)
        local l = F{AnchorPoint=Vector2.new(ax,ay),Position=UDim2.fromScale(px,py),Size=sx,BackgroundColor3=white,Rotation=rot or 0,Parent=par}
        R.frames[#R.frames+1] = l
        return l
    end
    local ring = F{AnchorPoint=CEN,Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(0.78,0.78),BackgroundTransparency=1,Parent=R.root}
    new("UICorner",{CornerRadius=UDim.new(1,0),Parent=ring})
    R.stroke = new("UIStroke",{Thickness=2,Color=white,Parent=ring})
    R.dash = new("UIGradient",{Transparency=kind=="esp" and DASH or NS{{0,0},{1,0}},Parent=R.stroke})
    if kind == "combat" then
        R.spin = F{AnchorPoint=CEN,Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Parent=R.root}
        line(R.spin,0.5,0,0.5,0.0,UDim2.new(0,3,0.22,0))
        line(R.spin,0.5,1,0.5,1.0,UDim2.new(0,3,0.22,0))
        line(R.spin,0,0.5,0.0,0.5,UDim2.new(0.22,0,0,3))
        line(R.spin,1,0.5,1.0,0.5,UDim2.new(0.22,0,0,3))
        line(R.root,0.5,1,0.5,0.44,UDim2.new(0,2,0.14,0))
        line(R.root,0.5,0,0.5,0.56,UDim2.new(0,2,0.14,0))
        line(R.root,1,0.5,0.44,0.5,UDim2.new(0.14,0,0,2))
        line(R.root,0,0.5,0.56,0.5,UDim2.new(0.14,0,0,2))
        local dot = F{AnchorPoint=CEN,Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(4,4),BackgroundColor3=white,Parent=R.root}
        new("UICorner",{CornerRadius=UDim.new(1,0),Parent=dot})
        R.frames[#R.frames+1] = dot
    else
        line(R.root,1,0.5,0.46,0.5,UDim2.new(0.46,0,0,1))
        line(R.root,0,0.5,0.54,0.5,UDim2.new(0.46,0,0,1))
        line(R.root,0.5,1,0.5,0.46,UDim2.new(0,1,0.46,0))
        line(R.root,0.5,0,0.5,0.54,UDim2.new(0,1,0.46,0))
        for _,d in ipairs({0.14,0.26,0.74,0.86}) do
            for _,axis in ipairs({"x","y"}) do
                local dot = F{AnchorPoint=CEN,Position=axis=="x" and UDim2.fromScale(d,0.5) or UDim2.fromScale(0.5,d),Size=UDim2.fromOffset(4,4),BackgroundColor3=white,Parent=R.root}
                new("UICorner",{CornerRadius=UDim.new(1,0),Parent=dot})
                R.frames[#R.frames+1] = dot
            end
        end
        R.dia = F{AnchorPoint=CEN,Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(0.22,0.22),BackgroundTransparency=1,Rotation=45,Parent=R.root}
        R.diaStroke = new("UIStroke",{Thickness=1.5,Color=white,Parent=R.dia})
    end
    function R.update(pos,size,color,t,speed,alpha)
        R.root.Visible = true
        R.root.Position = UDim2.fromOffset(pos.X,pos.Y)
        local pulse = 1 + 0.05*math.sin(t*4*speed)
        R.root.Size = UDim2.fromOffset(size*pulse,size*pulse)
        R.root.GroupTransparency = 1-alpha
        R.stroke.Color = color
        for _,f in ipairs(R.frames) do f.BackgroundColor3 = color end
        if R.diaStroke then R.diaStroke.Color = color R.dia.Rotation = 45 + (t*50*speed)%360 end
        if R.spin then R.spin.Rotation = (t*70*speed)%360 else R.dash.Rotation = (t*90*speed)%360 end
    end
    function R.hide() R.root.Visible = false end
    return R
end

