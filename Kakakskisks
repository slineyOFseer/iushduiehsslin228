local rmbE = false
local function candidatesInCircle()
    local m = UIS:GetMouseLocation()
    local list, c = {}, cam()
    for _,p in ipairs(Players:GetPlayers()) do
        if validPlayer(p) then
            local part = targetPart(p)
            if part then
                local v,on = c:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(v.X,v.Y)-m).Magnitude
                    if d <= S.circleR and visibleTo(part) then list[#list+1] = {p=p,part=part,d=d,pos=Vector2.new(v.X,v.Y)} end
                end
            end
        end
    end
    table.sort(list,function(a,b) return a.d<b.d end)
    return list
end

