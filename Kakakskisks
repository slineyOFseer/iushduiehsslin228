local accReg = {}
local function reg(obj, prop, which) accReg[#accReg+1] = {obj,prop,which or 1} obj[prop] = (which==2) and S.c2 or S.c1 end
local onColors = {}
local function applyColors()
    local keep = {}
    for _,a in ipairs(accReg) do
        if a[1].Parent then a[1][a[2]] = (a[3]==2) and S.c2 or S.c1 keep[#keep+1]=a end
    end
    accReg = keep
    for _,f in ipairs(onColors) do pcall(f) end
end

local function draggable(handle, target, canDrag)
    local dragging, startIn, startPos
    handle.InputBegan:Connect(function(i)
        if isPress(i) and (not canDrag or canDrag()) then dragging, startIn, startPos = true, i.Position, target.Position end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and isMove(i) then
            local d = i.Position - startIn
            target.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
    bind(UIS.InputEnded, function(i) if isPress(i) then dragging=false end end)
end

