local function keyScreen()
    local f = F{Size=UDim2.fromOffset(380,230),Position=UDim2.new(0.5,-190,0.5,-115),BackgroundColor3=Color3.fromRGB(10,9,20),ZIndex=5,Parent=gui}
    corner(f,16)
    local st = new("UIStroke",{Thickness=2,Color=white,Parent=f})
    local sg = new("UIGradient",{Parent=st})
    local ghost = new("TextLabel",{AnchorPoint=CEN,Position=UDim2.fromScale(0.78,0.5),Size=UDim2.fromScale(0.6,0.9),BackgroundTransparency=1,Text="Wy",Font=Enum.Font.Fondamento,TextScaled=true,TextTransparency=0.82,TextColor3=white,Parent=f})
    local gg = new("UIGradient",{Parent=ghost})
    local ttl = new("TextLabel",{Position=UDim2.fromOffset(0,16),Size=UDim2.new(1,0,0,40),BackgroundTransparency=1,Text="windy",Font=Enum.Font.Fondamento,TextSize=34,TextColor3=white,Parent=f})
    local tg = new("UIGradient",{Parent=ttl})
    new("TextLabel",{Position=UDim2.fromOffset(0,56),Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="enter your key",Font=Enum.Font.Gotham,TextSize=12,TextColor3=GRAY,Parent=f})
    local tb = new("TextBox",{AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,92),Size=UDim2.fromOffset(300,38),BackgroundColor3=Color3.fromRGB(20,18,36),Text="",PlaceholderText="key",
        PlaceholderColor3=Color3.fromRGB(110,110,135),TextColor3=white,Font=Enum.Font.GothamSemibold,TextSize=15,ClearTextOnFocus=false,Parent=f})
    corner(tb,10)
    local go = new("TextButton",{AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,142),Size=UDim2.fromOffset(300,38),Text="Login",Font=Enum.Font.GothamBold,TextSize=15,TextColor3=Color3.fromRGB(10,10,20),Parent=f})
    corner(go,10)
    local gog = new("UIGradient",{Parent=go})
    local msg = new("TextLabel",{Position=UDim2.fromOffset(0,190),Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text="",Font=Enum.Font.GothamBold,TextSize=14,TextColor3=Color3.fromRGB(255,70,90),Parent=f})
    local function col() 
        local cs = CS{{0,S.c1},{0.5,S.c2},{1,S.c1}}
        sg.Color, tg.Color, gg.Color, gog.Color = cs, cs, cs, cs
    end
    col()
    local conn = bind(RunService.RenderStepped,function()
        sg.Rotation = (os.clock()*70)%360
        gg.Rotation = (os.clock()*30)%360
        tg.Offset = Vector2.new(math.sin(os.clock()*1.5)*0.5,0)
    end)
    local busy = false
    local function submit()
        if busy then return end
        local k = tb.Text:lower():match("^%s*(.-)%s*$")
        if k=="basic" or k=="admin" then
            busy = true
            VERSION = (k=="admin") and "admin" or "free"
            msg.TextColor3 = Color3.fromRGB(90,255,160)
            msg.Text = k=="admin" and "ADMIN version activated" or "FREE version activated"
            task.wait(0.6)
            conn:Disconnect()
            f:Destroy()
            buildMain()
            buildWatermark()
        else
            msg.TextColor3 = Color3.fromRGB(255,70,90)
            msg.Text = "key incorrect"
            local p0 = f.Position
            for i=1,6 do
                f.Position = p0 + UDim2.fromOffset((i%2==0 and 8 or -8),0)
                task.wait(0.04)
            end
            f.Position = p0
        end
    end
    go.MouseButton1Click:Connect(submit)
    tb.FocusLost:Connect(function(enter) if enter then submit() end end)
end

-- menu toggle keybind
bind(UIS.InputBegan,function(i,gp)
    if gp or typing() or not VERSION or not setOpen then return end
    if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode.Name==S.menuKey then setOpen(not isOpen) end
end)

genv.SLINVC_UNLOAD = function()
    if not alive then return end
    alive = false
    for _,f in ipairs(cleanups) do pcall(f) end
    for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    gui:Destroy()
    genv.SLINVC_UNLOAD, genv.SLINVC_WM = nil, nil
end

