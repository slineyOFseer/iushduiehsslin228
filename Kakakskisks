local lockPlayer, lockPart, silentPart = nil, nil, nil

local function validPlayer(p)
    if p==LP then return false end
    if S.team and p.Team~=nil and p.Team==LP.Team then return false end
    local c = p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h~=nil and h.Health>0
end
local function targetPart(p)
    local c = p.Character
    if not c then return nil end
    return c:FindFirstChild(S.part) or c:FindFirstChild("HumanoidRootPart")
end
local function visibleTo(part)
    if not S.wall then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character, part.Parent}
    local o = cam().CFrame.Position
    return workspace:Raycast(o, part.Position-o, rp)==nil
end

-- silent aim hooks
local hooked = pcall(function()
    assert(hookmetamethod and newcclosure and checkcaller and getnamecallmethod)
    local oldIndex
    oldIndex = hookmetamethod(game,"__index",newcclosure(function(self,k)
        if alive and silentPart and self==Mouse and not checkcaller() then
            if k=="Hit" then return silentPart.CFrame end
            if k=="Target" then return silentPart end
        end
        return oldIndex(self,k)
    end))
    local oldNC
    oldNC = hookmetamethod(game,"__namecall",newcclosure(function(self,...)
        local m = getnamecallmethod()
        if alive and silentPart and self==workspace and not checkcaller() then
            if m=="Raycast" then
                local a = {...}
                if typeof(a[1])=="Vector3" then
                    a[2] = (silentPart.Position-a[1]).Unit*1000
                    return oldNC(self,table.unpack(a))
                end
            elseif m=="FindPartOnRayWithIgnoreList" or m=="FindPartOnRay" or m=="findPartOnRay" then
                local a = {...}
                if typeof(a[1])=="Ray" then
                    a[1] = Ray.new(a[1].Origin,(silentPart.Position-a[1].Origin).Unit*1000)
                    return oldNC(self,table.unpack(a))
                end
            end
        end
        return oldNC(self,...)
    end))
end)

