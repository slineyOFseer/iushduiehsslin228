local function setLine(fr,a,b,color)
    local d = b-a
    fr.Position = UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2)
    fr.Size = UDim2.fromOffset(d.Magnitude,1.5)
    fr.Rotation = math.deg(math.atan2(d.Y,d.X))
    fr.BackgroundColor3 = color
    fr.Visible = true
