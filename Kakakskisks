local function loadImage(src, imgLabel, status)
    src = (src or ""):match("^%s*(.-)%s*$")
    if src=="" then imgLabel.Image="" imgLabel.Visible=false S.bgImage="" save() status.Text="Image cleared" return end
    local asset
    local ok,err = pcall(function()
        if src:match("^%d+$") then asset = "rbxassetid://"..src
        elseif src:find("^rbxasset") then asset = src
        elseif src:find("^https?://") then
            local req = request or http_request or (syn and syn.request)
            assert(req and writefile and getcustomasset,"executor has no request/writefile")
            local res = req({Url=src,Method="GET"})
            assert(res and res.Body and #res.Body>100,"download failed")
            writefile("slinvc_bg.png",res.Body)
            asset = getcustomasset("slinvc_bg.png")
        else
            assert(isfile and isfile(src) and getcustomasset,"file not found in workspace folder")
            asset = getcustomasset(src)
        end
    end)
    if ok and asset then
        imgLabel.Image = asset imgLabel.Visible = true
        S.bgImage = src save()
        status.Text = "Image loaded"
    else status.Text = "Failed: "..tostring(err) end
end

