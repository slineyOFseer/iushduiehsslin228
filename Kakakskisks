    corner(ico,2) reg(ico,"BackgroundColor3")
    local tx = new("TextLabel",{Position=UDim2.fromOffset(30,0),Size=UDim2.new(1,-36,1,0),BackgroundTransparency=1,RichText=true,Font=Enum.Font.GothamSemibold,TextSize=13,
        TextColor3=Color3.fromRGB(235,235,248),TextXAlignment=Enum.TextXAlignment.Left,Text="",Parent=wm})
    genv.SLINVC_WM = wm
    draggable(wm,wm)
    local function hex(c) return string.format("#%02x%02x%02x",math.floor(c.R*255),math.floor(c.G*255),math.floor(c.B*255)) end
    local acc = 0
    bind(RunService.RenderStepped,function(dt)
        sg.Rotation = (os.clock()*60)%360
        sg.Color = CS{{0,S.c1},{0.5,S.c2},{1,S.c1}}
        ico.Rotation = 45+(os.clock()*80)%360
        acc += dt
        if acc>0.25 then
            acc = 0
            local ping = 0
            pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            local sep = '  <font color="#6a6a85">|</font>  '
            tx.Text = string.format('<font color="%s"><b>windy</b></font>%s%s%s%d fps%s%d ms',hex(S.c1),sep,LP.Name,sep,math.floor(fpsV+0.5),sep,math.floor(ping+0.5))
            wm.Size = UDim2.fromOffset(math.max(200,tx.TextBounds.X+46),30)
        end
    end)
end

